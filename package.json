{
  "name": "tinyfactory",
  "version": "0.4.0",
  "description": "Watch your AI agent automations run as a cozy 3D miniature factory. Auto-discovers Claude Code, Codex, OpenClaw, cron, launchd, systemd and Windows Task Scheduler jobs, plus GitHub Actions.",
  "type": "module",
  "bin": {
    "tinyfactory": "bin/tinyfactory.mjs"
  },
  "files": [
    "bin",
    "src",
    "web",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/*.md",
    "examples",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/tinyfactory.mjs",
    "demo": "node bin/tinyfactory.mjs --demo",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "coverage": "node --test --experimental-test-coverage",
    "record": "node scripts/record.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "agents",
    "automation",
    "dashboard",
    "claude-code",
    "codex",
    "openclaw",
    "cron",
    "github-actions",
    "task-scheduler",
    "systemd",
    "launchd",
    "three.js",
    "isometric",
    "visualization"
  ],
  "author": "ybkjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ybkjs/tinyfactory.git"
  },
  "homepage": "https://github.com/ybkjs/tinyfactory#readme",
  "bugs": {
    "url": "https://github.com/ybkjs/tinyfactory/issues"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.14.0"
  }
}
