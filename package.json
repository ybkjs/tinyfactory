{
  "name": "tinyfactory",
  "version": "0.1.0",
  "description": "Watch your AI agent automations run as a cozy 3D miniature factory. Auto-discovers Claude Code, Codex, OpenClaw, cron, launchd and systemd jobs.",
  "type": "module",
  "bin": {
    "tinyfactory": "bin/tinyfactory.mjs"
  },
  "files": [
    "bin",
    "src",
    "web",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/tinyfactory.mjs",
    "demo": "node bin/tinyfactory.mjs --demo",
    "test": "node --test test/*.test.mjs",
    "record": "node scripts/record.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "agents",
    "automation",
    "dashboard",
    "claude-code",
    "codex",
    "openclaw",
    "cron",
    "three.js",
    "isometric",
    "visualization"
  ],
  "author": "bai-429",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bai-429/tinyfactory.git"
  },
  "homepage": "https://github.com/bai-429/tinyfactory#readme",
  "bugs": {
    "url": "https://github.com/bai-429/tinyfactory/issues"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1"
  }
}
